# Optional local overrides for Pi-Father Spinner
# Copy to .env (ignored by git) if running locally

# Master Pi-Father Telegram Bot Token (from @BotFather)
# FATHER_BOT_TOKEN="123456789:AAExampleToken"

# Your numeric Telegram User ID
# ALLOWED_TELEGRAM_USER_ID="123456789"

# Custom directory for child projects (default: ~/projects)
# PI_PROJECTS_ROOT="/home/dante/projects"

# Custom directory for SQLite durable state & child configs (default: ~/.pi/agent/father-spinner)
# PI_FATHER_DATA_DIR="/home/dante/.pi/agent/father-spinner"
